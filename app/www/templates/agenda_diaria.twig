{% extends "base.twig" %}

{% block titulo %}Agenda{% endblock %}

{% block contenido %}
    <section class="cabecera-agenda" aria-labelledby="titulo-agenda-principal">
        <div class="tarjeta-cabecera">
            <div class="circulo-foto-estudiante">
                {% if foto_estudiante is defined and foto_estudiante %}
                    <img src="data:image/jpeg;base64,{{ foto_estudiante }}"
                         alt="{{ nombre_estudiante ? 'Foto de perfil de ' ~ nombre_estudiante : 'Foto de perfil del estudiante' }}">
                {% endif %}
            </div>

            <div class="datos-cabecera">
                <h1 id="titulo-agenda-principal" class="titulo-agenda">Agenda</h1>
                <p class="texto-fecha">
                    <span class="sr-only">Fecha: {{ fecha_accesible|default('Jueves, 19 de Noviembre') }}</span>
                    <span aria-hidden="true">{{ fecha|default('📅 Jueves, 19 de Noviembre') }}</span>
                </p>
                {% if nombre_estudiante is defined and nombre_estudiante %}
                    <p class="nombre-estudiante">
                        <span class="sr-only">Estudiante: </span>{{ nombre_estudiante }}
                    </p>
                {% endif %}
            </div>
        </div>
    </section>

    <main id="contenido-principal" class="lista-actividades" tabindex="-1" aria-label="Actividades del día">
        <ul class="lista-actividades-ul">
            {% for actividad in actividades %}
                <li class="item-actividad">
                    <a href="{{ actividad.url|default('#tarea-' ~ actividad.id) }}"
                       class="franja-actividad {{ actividad.activa ? 'es-activa' : '' }}"
                       data-actividad-id="{{ actividad.id }}"
                       aria-label="Hora {{ actividad.hora }}, actividad {{ actividad.nombre }}{{ actividad.activa ? ', actividad actual' : '' }}">

                        <span class="circulo-hora" aria-hidden="true">
                            <time datetime="{{ actividad.hora }}">{{ actividad.hora }}</time>
                        </span>

                        <span class="caja-nombre-actividad">
                            {% if actividad.img is defined and actividad.img %}
                                <img src="data:image/png;base64,{{ actividad.img }}" alt="" aria-hidden="true" class="img-actividad">
                            {% endif %}
                            <span class="texto-actividad">{{ actividad.nombre }}</span>
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}

{% block scripts %}
    <script src="../js/agenda_diaria.js" defer></script>
{% endblock %}