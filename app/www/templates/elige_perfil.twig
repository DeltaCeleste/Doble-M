
{% extends "base.twig" %}

{% block titulo %}Inicio de Sesión{% endblock %}

{% block contenido %}

    <main id="contenido-principal" class="pantalla-eleccion-perfil">

        <h1 class="titulo-inicio-sesion">Inicio de Sesión</h1>

        <section class="panel-eleccion-perfil" aria-labelledby="titulo-perfiles">

            <h2 id="titulo-perfiles">¿QUIÉN ERES?</h2>

            <div class="contenedor-perfiles">
                {% for alumno in alumnos %}
                    <div class="tarjeta-perfil">
                        <button type="button"
                                class="opcion-perfil"
                                data-id-usuario="{{ alumno.id_usuario }}"
                                data-formato-visual="{{ alumno.formato_visual|default('picto') }}"
                                aria-pressed="false">
                            {% if alumno.foto_uri %}
                                <img src="{{ alumno.foto_uri }}" alt="{{ alumno.nombre_usuario }}" class="imagen-perfil">
                            {% else %}
                                <span class="imagen-pendiente">{{ alumno.nombre_usuario }}</span>
                            {% endif %}
                        </button>
                        <span class="nombre-perfil">{{ alumno.nombre_usuario }}</span>
                    </div>
                {% else %}
                    <p>No hay alumnos registrados en esta clase.</p>
                {% endfor %}
            </div>
            

            <input type="hidden" id="perfil-seleccionado" name="perfil">

            <div class="acciones-eleccion-perfil">
                <button type="button"
                        id="btn-siguiente-perfil"
                        class="boton-siguiente-perfil"
                        disabled
                        aria-label="Continuar a la siguiente pantalla">
                    <span aria-hidden="true">➡️</span>
                </button>
            </div>

        </section>

    </main>

{% endblock %}

{% block scripts %}
    <script src="../js/elige_perfil.js?v=2" defer></script>
{% endblock %}
